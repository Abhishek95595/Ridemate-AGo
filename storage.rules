rules_version = '2';

// Deploy with: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    match /profile_pictures/{userId}/{fileName} {
      allow read: if true;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    match /driver_licences/{userId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Legacy paths used in profile_service.dart
    match /user_profiles/{fileName} {
      allow read, write: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }

    match /user_licences/{fileName} {
      allow read, write: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
