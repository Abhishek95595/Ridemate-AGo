# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing (never commit keystore or credentials)
/android/key.properties
/android/keystore/

# Firebase CLI local deploy cache (not .firebaserc — that one is tracked)
/.firebase/

# Local dart defines with sensitive keys
dart_defines.json
android/local.properties

# Firebase Functions
functions/node_modules/
functions/lib/
